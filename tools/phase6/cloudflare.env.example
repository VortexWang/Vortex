# Copy to tools/phase6/cloudflare.env and fill in values locally.
# Keep this file and the token-policy file out of evidence and source control.

# Cloudflare API token created specifically for the dedicated test zone.
# Required permission: Zone / DNS / Edit; scope must include only CLOUDFLARE_ZONE_ID.
CLOUDFLARE_API_TOKEN=replace-with-dedicated-zone-dns-edit-token

# ID of the dedicated disposable test zone used by the 06-10 CRUD test.
CLOUDFLARE_ZONE_ID=replace-with-dedicated-test-zone-id

# PostgreSQL used by the integration test. The local disposable default is shown.
PHASE6_DATABASE_URL=postgres://vortex:phase6-local-test-only@127.0.0.1:15436/vortex?sslmode=disable

# Path to a reviewed, redacted export or inspector output proving the token's
# least-zone policy. Use either this or CLOUDFLARE_POLICY_TOKEN below.
CLOUDFLARE_TOKEN_POLICY_FILE=tools/phase6/cloudflare-token-policy.json

# Optional alternative to the policy file. Leave empty when using the file.
CLOUDFLARE_POLICY_TOKEN=

# Run with:
#   set -a; . tools/phase6/cloudflare.env; set +a
#   ./tools/phase6/cloudflare_integration.sh
