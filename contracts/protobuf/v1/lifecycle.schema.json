        },
        "billing_snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rule_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "path_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "fencing_generation_floor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "signer_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "rate_bps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "hard_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "backend_heartbeat_at": {
          "type": "string",
          "format": "date-time"
        },
        "autonomy_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "share_references": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/share_reference"
          }
        },
        "policy_transitions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/policy_transition"
          }
        }
      },
      "required": [
        "allocation_id",
        "delegation_id",
        "hub_id",
        "region_id",
        "node_id",
        "boot_id",
        "source_id",
        "runtime_source_id",
        "share_source_id",
        "billing_snapshot_id",
        "rule_id",
        "rule_revision",
        "path_generation",
        "fencing_generation_floor",
        "signer_epoch",
        "raw_bytes",
        "rate_bps",
        "connections",
        "valid_from",
        "expires_at",
        "hard_deadline",
        "backend_heartbeat_at",
        "autonomy_deadline",
        "share_references",
        "policy_transitions"
      ]
    },
    "ledger_ack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 257
        },
        "ledger_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "issue",
            "known",
            "unknown",
            "handoff"
          ]
        }
      },
      "required": [
        "record_id",
        "ledger_sequence",
        "payload_sha256",
        "kind"
      ]
    },
    "share_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "share_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "parent_share_id": {
          "anyOf": [
