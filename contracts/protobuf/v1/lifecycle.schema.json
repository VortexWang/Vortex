{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vortex.invalid/contracts/control/lifecycle/1.3.0",
  "title": "Control 1.3.0 lifecycle semantic projections",
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_version": {
          "const": "1.3.0"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "status-v1",
              "renewal-v1",
              "identity-v1",
              "recovery-v1",
              "share-policy-v1",
              "backend-ledger-v1",
              "usage-ledger-v1",
              "runtime-lease-refresh-v1"
            ]
          },
          "uniqueItems": true
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "region_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "control_version",
        "capabilities",
        "session_id",
        "region_id"
      ]
    },
    "node_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "build_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "applied_config_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "probes": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "state": {
                "enum": [
                  "unknown",
                  "healthy",
                  "unhealthy"
                ]
              },
              "failures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "successes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "latency_us": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "target_id",
              "state",
              "failures",
              "successes",
              "observed_at",
              "latency_us"
            ]
          }
        },
        "active_sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "drain_state": {
          "enum": [
            "running",
            "draining",
            "stopped"
          ]
        }
      },
      "required": [
        "report_id",
        "build_version",
        "applied_config_version",
        "observed_at",
        "probes",
        "active_sessions",
        "drain_state"
      ]
    },
    "renewal_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "delegation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rule_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "path_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "fencing_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "signer_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "requested_raw_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "requested_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "billing_snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "request_id",
        "node_id",
        "boot_id",
        "delegation_id",
        "source_id",
        "rule_id",
        "rule_revision",
        "path_generation",
        "fencing_generation",
        "signer_epoch",
        "requested_raw_bytes",
        "requested_ttl_seconds",
        "request_sha256",
        "billing_snapshot_id"
      ]
    },
    "renewal_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code": {
          "enum": [
            "ok",
            "invalid_request",
            "unsupported_capability",
            "identity_mismatch",
            "stale_session",
            "stale_revision",
            "closed_epoch",
            "scope_denied",
            "quota_exhausted",
            "time_uncertain",
            "storage_unavailable",
            "temporarily_unavailable"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "authorization_update_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "request_id",
        "request_sha256",
        "code",
        "retryable"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "authorization_update_sha256"
            ],
            "properties": {
              "retryable": {
                "const": false
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "authorization_update_sha256"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "storage_unavailable",
                  "temporarily_unavailable"
                ]
              }
            }
          }
        }
      ]
    },
    "hub_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hub_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "region_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "enum": [
            "online",
            "autonomous",
            "recovering",
            "blocked"
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "control_version": {
          "const": "1.3.0"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "status-v1",
              "renewal-v1",
              "identity-v1",
              "recovery-v1",
              "share-policy-v1",
              "backend-ledger-v1",
              "runtime-lease-refresh-v1"
            ]
          },
          "uniqueItems": true
        },
        "signer_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "recovery_target_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "confirmed_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "pending_tail_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "backend_heartbeat_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "const": ""
            }
          ]
        },
        "autonomy_deadline": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "const": ""
            }
          ]
        },
        "revocation_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "restriction_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "hub_id",
        "region_id",
        "mode",
        "session_id",
        "control_version",
        "capabilities",
        "signer_epoch",
        "recovery_target_sequence",
        "confirmed_sequence",
        "pending_tail_records",
        "backend_heartbeat_at",
        "autonomy_deadline",
        "revocation_revision",
        "restriction_revision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "blocked"
              }
            }
          },
          "else": {
            "properties": {
              "signer_epoch": {
                "type": "integer",
                "minimum": 1
              },
              "backend_heartbeat_at": {
                "type": "string",
                "format": "date-time"
              },
              "autonomy_deadline": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "credential_revocations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "certificate_serials": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,48}$"
          },
          "uniqueItems": true
        },
        "node_ids": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "issuer_id",
        "revision",
        "certificate_serials",
        "node_ids",
        "effective_at"
      ]
    },
    "backend_heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "hub_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "region_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "autonomy_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "revocation_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "restriction_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "backend_id",
        "hub_id",
        "session_id",
        "region_id",
        "observed_at",
        "autonomy_deadline",
        "revocation_revision",
        "restriction_revision"
      ]
    },
    "backend_allocation": {
      "type": "object",
