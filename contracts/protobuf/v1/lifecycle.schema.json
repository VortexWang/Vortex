        },
        "rule_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "path_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "rate_bps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "hard_deadline": {
          "type": "string",
          "format": "date-time"
        }
      },
