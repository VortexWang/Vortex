{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vortex.invalid/contracts/runtime/config/1.2.0",
  "title": "VORTEX Runtime Configuration 1.2.0 candidate",
  "description": "Owner review pending. Legacy 1.1 inputs are unchanged; committed canonical per-node artifacts use the separately negotiated RuleCommand path. This schema alone grants no authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/legacy"
    },
    {
      "$ref": "#/$defs/rule_artifact"
    }
  ],
  "$defs": {
    "legacy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://vortex.invalid/contracts/runtime/config/1.1.0",
      "title": "VORTEX Runtime Configuration",
      "description": "Compatible lifecycle extensions; authoritative version/hash status is recorded in governance.",
      "type": "object",
      "required": [
        "version",
        "node_id",
        "listeners",
        "rules",
        "revocations"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonic configuration version; ENG-029."
        },
        "node_id": {
          "type": "string",
          "format": "uuid"
        },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "port_id",
              "kind",
              "address",
              "port"
            ],
            "properties": {
              "port_id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "service",
                  "link",
                  "control",
                  "metrics"
                ]
              },
              "address": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "revision",
              "role",
              "hop_index",
              "mode",
              "targets",
              "allowed_upstream_node_ids"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "path_generation": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "enum": [
                  "entry",
                  "relay",
                  "exit"
                ]
              },
              "hop_index": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "enum": [
                  "direct",
                  "tunnel",
                  "multi_hop"
                ]
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowed_upstream_node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "idle_timeout_seconds": {
                "type": "integer",
                "minimum": 10,
                "default": 60
              },
              "link_mode": {
                "enum": [
                  "auto",
                  "mux",
                  "pool"
                ],
                "default": "auto"
              },
              "share_reference_ids": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "policy_transition_ids": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "revocations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drain_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "default": 300
        },
        "link": {
          "type": "object",
          "properties": {
            "max_frame_payload_bytes": {
              "const": 16384,
              "default": 16384
            },
            "stream_initial_window_bytes": {
              "const": 262144,
              "default": 262144
            },
            "stream_max_window_bytes": {
              "const": 4194304,
              "default": 4194304
            },
            "mux_links_per_peer": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4,
              "default": 2
            },
            "pool_mux_threshold_seconds": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            },
            "idle_ping_seconds": {
              "const": 3,
              "default": 3
            },
            "failure_timeout_seconds": {
              "const": 12,
              "default": 12
            }
          },
          "additionalProperties": false
        },
        "billing": {
          "type": "object",
          "properties": {
            "automatic_risk_budget_bytes": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "billing_switch_cancel_seconds": {
              "const": 1,
              "default": 1
            },
            "missing_grant_wait_ms": {
              "const": 200,
              "default": 200
            },
            "time_protection_seconds": {
              "const": 12,
              "default": 12
            }
          },
          "additionalProperties": false
        },
        "activation": {
          "type": "object",
          "properties": {
            "bootstrap_prepare_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 300,
              "default": 120
            },
            "connection_drain_seconds": {
              "const": 60,
              "default": 60
            }
          },
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "udp_socket_buffer_bytes": {
              "type": "integer",
              "minimum": 1,
              "default": 4194304
            },
            "pull_interval_seconds": {
              "const": 1,
              "default": 1
            },
            "report_interval_seconds": {
              "const": 10,
              "default": 10
            },
            "retention_days": {
              "type": "integer",
              "minimum": 7,
              "default": 7
            }
          },
          "additionalProperties": false
        },
        "lease": {
          "type": "object",
          "properties": {
            "runtime_ttl_seconds": {
              "const": 300,
              "default": 300
            },
            "renew_interval_seconds": {
              "const": 60,
              "default": 60
            },
            "share_ttl_max_seconds": {
              "const": 300,
              "default": 300
            },
            "share_floor_percent": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "autonomy_deadline_hours": {
              "type": "number",
              "maximum": 12,
              "default": 12
            }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "region_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "hubs": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "hub_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "endpoint": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      },
                      "server_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                      }
                    },
                    "required": [
                      "hub_id",
                      "endpoint",
                      "server_name"
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "region_id",
                "hubs"
              ]
            },
            "dial_timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "watchdog_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "failover_budget_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "retry_min_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            },
            "retry_max_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            },
            "probe_interval_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            "probe_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "probe_workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "report_interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "renew_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "renew_retry_min_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            },
            "preissue_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "policy_guard_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            }
          },
          "required": [
            "region"
          ]
        },
        "probe_targets": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "rule_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "protocol": {
                "enum": [
                  "tcp",
                  "udp"
                ]
              }
            },
            "required": [
              "target_id",
              "rule_id",
              "protocol"
            ]
          }
        }
      },
      "x-vortex-source": {
        "status": "versioned",
        "requirements": [
          "AGT-002",
          "AGT-005",
          "AGT-007",
          "AGT-012",
          "HUB-013",
          "HUB-014",
          "HUB-018",
          "SUP-B3-001"
        ]
      }
    },
    "rule_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "rule_id",
        "rule_revision",
        "node_id",
        "boot_id",
        "signer_epoch",
        "path_generation",
        "fencing_generation",
        "billing_snapshot_id",
        "input_digest",
        "input_versions",
        "intent"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "rule_revision": {
          "type": "integer",
          "minimum": 1
        },
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "signer_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "path_generation": {
          "type": "integer",
          "minimum": 1
        },
        "fencing_generation": {
          "type": "integer",
          "minimum": 1
        },
        "billing_snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "role",
            "hop_index",
            "allowed_upstream_node_ids",
            "upstream_members",
            "next_members",
            "next_scheduling",
            "segments",
            "session_stable"
          ],
          "properties": {
            "rule": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "protocol",
                "mode",
                "port",
                "path",
                "directions",
                "targets",
                "scheduling",
                "proxy_protocol",
                "idle_timeout_seconds",
                "rate_limit",
                "connection_limit",
                "enabled"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "protocol": {
                  "enum": [
                    "tcp",
                    "udp",
                    "tcp_udp"
                  ]
                },
                "mode": {
                  "enum": [
                    "direct",
                    "tunnel",
                    "multi_hop"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "maxItems": 16
                },
                "directions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "auto",
                      "forward",
                      "reverse"
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 15
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "address",
                      "weight",
                      "priority"
                    ],
                    "properties": {
                      "address": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 259
                      },
                      "weight": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "scheduling": {
                  "enum": [
                    "weighted_round_robin",
                    "primary_backup"
                  ]
                },
                "proxy_protocol": {
                  "enum": [
                    "off",
                    "v1",
                    "v2"
                  ]
                },
                "idle_timeout_seconds": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 86400
                },
                "rate_limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "connection_limit": {
                  "type": "integer",
                  "minimum": 0
                },
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "role": {
              "enum": [
                "entry",
                "relay",
                "exit"
              ]
            },
            "hop_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "allowed_upstream_node_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "minItems": 0,
              "maxItems": 256
            },
            "upstream_members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "boot_id",
                  "public_address",
                  "version",
                  "generation",
                  "link_port",
                  "weight",
                  "priority",
                  "online"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "boot_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "public_address": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "link_port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "online": {
                    "const": true
                  }
                }
              },
              "minItems": 0,
              "maxItems": 256
            },
            "next_members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "boot_id",
                  "public_address",
                  "version",
                  "generation",
                  "link_port",
                  "weight",
                  "priority",
                  "online"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "boot_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "public_address": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "link_port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "online": {
                    "const": true
                  }
                }
              },
              "minItems": 0,
              "maxItems": 256
            },
            "next_scheduling": {
              "enum": [
                "",
                "dns",
                "weighted_round_robin",
                "primary_backup"
              ]
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hop",
                  "from",
                  "to",
                  "direction",
                  "permit_version"
                ],
                "properties": {
                  "hop": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 14
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "direction": {
                    "enum": [
                      "forward",
                      "reverse"
                    ]
                  },
                  "permit_version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "minItems": 0,
              "maxItems": 15
            },
            "session_stable": {
              "const": true
            }
          }
        }
      }
    }
  }
}
